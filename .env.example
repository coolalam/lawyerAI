# 进程环境变量示例；应用不会自动加载此文件，请在启动环境中设置。
LAW_DATA_DIR=./data
LAW_DB_PATH=./data/office.sqlite3
LAW_PORT=8000
# HTTPS 部署时启用：
# LAW_HTTPS=1
# LAW_ALLOWED_ORIGINS=https://law.example.com
# MCP 自动允许 LAW_ALLOWED_ORIGINS 对应的 Host；额外 Host 可单独配置（保留端口）：
# LAW_MCP_ALLOWED_HOSTS=law.example.com,law.example.com:8443
# 源库密码通过迁移程序交互输入，不放在这里。
